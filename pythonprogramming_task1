import random

# Hangman Game
print("=" * 40)
print("       WELCOME TO HANGMAN GAME")
print("=" * 40)

# Predefined words
words = ["python", "computer", "program", "coding", "developer"]

# Select a random word
secret_word = random.choice(words)

# Store guessed letters
guessed_letters = []

# Maximum incorrect attempts
max_attempts = 6
wrong_attempts = 0

# Hangman drawings for each incorrect guess
hangman_stages = [
    """
       -----
       |   |
           |
           |
           |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
           |
           |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
       |   |
           |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
      /|   |
           |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
      /|\\  |
           |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
      /|\\  |
      /    |
           |
    =========
    """,
    """
       -----
       |   |
       O   |
      /|\\  |
      / \\  |
           |
    =========
    """
]

print("\nGuess the hidden word one letter at a time!")
print("You have 6 incorrect attempts.")

# Main game loop
while wrong_attempts < max_attempts:

    # Display the current hangman drawing
    print(hangman_stages[wrong_attempts])

    # Display the word with guessed letters
    display_word = ""

    for letter in secret_word:
        if letter in guessed_letters:
            display_word += letter + " "
        else:
            display_word += "_ "

    print("Word:", display_word)
    print("Incorrect attempts:", wrong_attempts)
    print("Remaining attempts:", max_attempts - wrong_attempts)

    # Check whether the player has won
    if all(letter in guessed_letters for letter in secret_word):
        print("\nCongratulations! You won!")
        print("The correct word was:", secret_word)
        break

    # Take input from the player
    guess = input("\nEnter a single letter: ").lower().strip()

    # Validate input
    if len(guess) != 1 or not guess.isalpha():
        print("Invalid input! Please enter one letter.")
        continue

    # Check for repeated guesses
    if guess in guessed_letters:
        print("You already guessed that letter!")
        continue

    # Store the guessed letter
    guessed_letters.append(guess)

    # Check the guess
    if guess in secret_word:
        print("Correct guess!")
    else:
        wrong_attempts += 1
        print("Wrong guess!")

# Display the final result
if all(letter in guessed_letters for letter in secret_word):
    print("\nYOU WIN!")
else:
    print(hangman_stages[max_attempts])
    print("\nGAME OVER!")
    print("The correct word was:", secret_word)

print("\nThank you for playing Hangman!")
