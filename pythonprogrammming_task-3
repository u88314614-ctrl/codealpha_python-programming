import csv

# Predefined stock prices
stock_prices = {
    "AAPL": 180,
    "TSLA": 250,
    "GOOGL": 140,
    "MSFT": 420,
    "AMZN": 190
}

portfolio = []
total_investment = 0

print("===== STOCK PORTFOLIO TRACKER =====")

for stock, price in stock_prices.items():
    print(f"{stock}: ${price}")

while True:
    stock = input("\nEnter stock name (or 'done' to finish): ").upper()

    if stock == "DONE":
        break

    if stock not in stock_prices:
        print("Stock not found. Choose an available stock.")
        continue

    try:
        quantity = int(input("Enter quantity: "))
        if quantity <= 0:
            print("Quantity must be greater than zero.")
            continue
    except ValueError:
        print("Enter a valid whole number.")
        continue

    price = stock_prices[stock]
    investment = price * quantity
    total_investment += investment

    portfolio.append({
        "Stock": stock,
        "Quantity": quantity,
        "Price": price,
        "Investment": investment
    })

    print(f"Investment in {stock}: ${investment}")

print("\n===== PORTFOLIO SUMMARY =====")

if not portfolio:
    print("No stocks were added.")
else:
    for item in portfolio:
        print(
            f"{item['Stock']} | Quantity: {item['Quantity']} | "
            f"Price: ${item['Price']} | "
            f"Investment: ${item['Investment']}"
        )

    print(f"Total Investment: ${total_investment}")

    save = input("Save report to CSV? (yes/no): ").lower()

    if save == "yes":
        with open("portfolio.csv", "w", newline="") as file:
            writer = csv.DictWriter(
                file,
                fieldnames=[
                    "Stock", "Quantity", "Price", "Investment"
                ]
            )
            writer.writeheader()
            writer.writerows(portfolio)

        print("Report saved as portfolio.csv")
